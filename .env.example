# Copiar a .env.local (no se commitea) y rellenar.

# Ruta absoluta a la carpeta de contenido (repo git independiente de este proyecto).
# En desarrollo puede apuntar a ./atlas-content-dev; en producción, a la ruta real
# del atlas del usuario (ver specs/02-design.md §9).
CONTENT_DIR=./atlas-content-dev

# Usuario único del atlas.
AUTH_USER=pasta0126

# Hash bcrypt de la contraseña (nunca la contraseña en texto plano).
# Generar con: npx bcrypt-cli "tu-contraseña"
AUTH_PASSWORD_HASH=

# Secreto para firmar la cookie de sesión (cadena aleatoria larga).
# Generar con: openssl rand -base64 32
SESSION_SECRET=

# Nombre/email de autor para los commits automáticos sobre CONTENT_DIR.
GIT_AUTHOR_NAME=pasta0126
GIT_AUTHOR_EMAIL=pasta0126@gmail.com
