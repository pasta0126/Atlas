# Copiar a .env.local (no se commitea) y rellenar.

# Ruta absoluta a la carpeta de contenido: un repo git independiente de este
# proyecto (p. ej. ~/vedlvm, en paralelo a ~/atlas). Este repo solo lee/escribe
# ahí dentro, no le importa su estructura interna ni si tiene su propio .git
# (lib/git.ts hace los commits automáticos directamente sobre CONTENT_DIR).
CONTENT_DIR=/home/pasta0126/vedlvm

# Usuario único del atlas.
AUTH_USER=pasta0126

# Hash bcrypt de la contraseña (nunca la contraseña en texto plano).
# Generar con: npx bcrypt-cli "tu-contraseña"
AUTH_PASSWORD_HASH=

# Secreto para firmar la cookie de sesión (cadena aleatoria larga).
# Generar con: openssl rand -base64 32
SESSION_SECRET=

# Nombre/email de autor para los commits automáticos sobre CONTENT_DIR.
GIT_AUTHOR_NAME=pasta0126
GIT_AUTHOR_EMAIL=pasta0126@gmail.com
